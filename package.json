{
  "name": "marketplace-api",
  "version": "1.0.0",
  "description": "Marketplace API is a backend service for buyers and independent sellers. Buyers can browse products and place orders, while sellers can publish products, manage their availability, and process received orders.",
  "main": "index.js",
  "scripts": {
    "lint:openapi": "redocly lint openapi/openapi.yaml",
    "bundle:openapi": "redocly bundle openapi/openapi.yaml -o spec.json",
    "test": "npm run lint:openapi",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && node dist/main.js",
    "start:dev": "nest start --watch",
    "check:env": "npm run build --silent && node scripts/check-env-example.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KseniaLF/marketplace-api.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/KseniaLF/marketplace-api/issues"
  },
  "homepage": "https://github.com/KseniaLF/marketplace-api#readme",
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@redocly/cli": "^2.46.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "dotenv": "^18.0.8",
    "express": "^4.22.2",
    "express-openapi-validator": "^5.6.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  }
}
